#. Key:	3663872764
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1315).ExplorerNoteEntries.BinkMediaSubtitles(11).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1315).ExplorerNoteEntries.BinkMediaSubtitles(11).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,3663872764"
msgid "Yeah, well, you know me, Meiyin -- I’m a shooting star, baby."
msgstr "Yeah, well, you know me, Meiyin -- I’m a shooting star, baby."

#. Key:	3845230608
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1315).ExplorerNoteEntries.BinkMediaSubtitles(12).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1315).ExplorerNoteEntries.BinkMediaSubtitles(12).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,3845230608"
msgid "Santi and I are... we share something from that future we both came from."
msgstr "Santi and I are... we share something from that future we both came from."

#. Key:	2623359162
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1315).ExplorerNoteEntries.BinkMediaSubtitles(13).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1315).ExplorerNoteEntries.BinkMediaSubtitles(13).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,2623359162"
msgid "It’s different with him from you and I, but it’s real too."
msgstr "It’s different with him from you and I, but it’s real too."

#. Key:	4253647682
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1315).ExplorerNoteEntries.BinkMediaSubtitles(14).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1315).ExplorerNoteEntries.BinkMediaSubtitles(14).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,4253647682"
msgid "So I’d appreciate you making sure he gets back in one piece."
msgstr "So I’d appreciate you making sure he gets back in one piece."

#. Key:	4121414407
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1315).ExplorerNoteEntries.BinkMediaSubtitles(15).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1315).ExplorerNoteEntries.BinkMediaSubtitles(15).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,4121414407"
msgid "I understand. We will both see you again soon, Diana."
msgstr "I understand. We will both see you again soon, Diana."

#. Key:	2211955028
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1315).ExplorerNoteEntries.BinkMediaSubtitles(2).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1315).ExplorerNoteEntries.BinkMediaSubtitles(2).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,2211955028"
msgid "It still is dangerous to bring her into the wilds."
msgstr "It still is dangerous to bring her into the wilds."

#. Key:	638433637
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1315).ExplorerNoteEntries.BinkMediaSubtitles(3).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1315).ExplorerNoteEntries.BinkMediaSubtitles(3).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,638433637"
msgid "I would feel better if you were coming along."
msgstr "I would feel better if you were coming along."

#. Key:	3139582331
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1315).ExplorerNoteEntries.BinkMediaSubtitles(4).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1315).ExplorerNoteEntries.BinkMediaSubtitles(4).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,3139582331"
msgid "Nice of you to say, but someone has to keep an eye on our ‘good doctor.’"
msgstr "Nice of you to say, but someone has to keep an eye on our ‘good doctor.’"

#. Key:	664175652
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1315).ExplorerNoteEntries.BinkMediaSubtitles(5).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1315).ExplorerNoteEntries.BinkMediaSubtitles(5).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,664175652"
msgid "‘Sides, this way you two get a chance to catch up,"
msgstr "‘Sides, this way you two get a chance to catch up,"

#. Key:	831526519
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1315).ExplorerNoteEntries.BinkMediaSubtitles(6).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1315).ExplorerNoteEntries.BinkMediaSubtitles(6).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,831526519"
msgid "...rekindle the fires and all that."
msgstr "...rekindle the fires and all that."

#. Key:	1533710908
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1315).ExplorerNoteEntries.BinkMediaSubtitles(7).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1315).ExplorerNoteEntries.BinkMediaSubtitles(7).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,1533710908"
msgid "Juzi, stop. Bringing Helena on this mission was not my idea."
msgstr "Juzi, stop. Bringing Helena on this mission was not my idea."

#. Key:	3899845832
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1315).ExplorerNoteEntries.BinkMediaSubtitles(8).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1315).ExplorerNoteEntries.BinkMediaSubtitles(8).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,3899845832"
msgid "I know, dummy. Who do you think put the word in Santiago’s ear?"
msgstr "I know, dummy. Who do you think put the word in Santiago’s ear?"

#. Key:	2378457970
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1315).ExplorerNoteEntries.BinkMediaSubtitles(9).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1315).ExplorerNoteEntries.BinkMediaSubtitles(9).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,2378457970"
msgid "She’s ready. So are you."
msgstr "She’s ready. So are you."

#. Key:	1181277117
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1316).ExplorerNoteEntries.BinkMediaSubtitles(0).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1316).ExplorerNoteEntries.BinkMediaSubtitles(0).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,1181277117"
msgid "I’m so sorry, Meiyin. I could feel how close you two were..."
msgstr "I’m so sorry, Meiyin. I could feel how close you two were..."

#. Key:	176618944
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1316).ExplorerNoteEntries.BinkMediaSubtitles(0).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1316).ExplorerNoteEntries.BinkMediaSubtitles(0).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,176618944"
msgid "<<Meiyin and Helena Walker>> Archival Audio 006\r\nCross-references:  <<Diana Altaras and Edmund Rockwell>>\r\n\r\nThe following conversation took place after the burial of Diana Altaras on the Aberrant ARK."
msgstr "<<Meiyin and Helena Walker>> Archival Audio 006\r\nCross-references:  <<Diana Altaras and Edmund Rockwell>>\r\n\r\nThe following conversation took place after the burial of Diana Altaras on the Aberrant ARK."

#. Key:	613553952
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1316).ExplorerNoteEntries.BinkMediaSubtitles(1).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1316).ExplorerNoteEntries.BinkMediaSubtitles(1).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,613553952"
msgid "She said the same thing about you and I."
msgstr "She said the same thing about you and I."

#. Key:	318385746
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1316).ExplorerNoteEntries.BinkMediaSubtitles(10).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1316).ExplorerNoteEntries.BinkMediaSubtitles(10).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,318385746"
msgid "Me and my big mouth. Sorry, I’m still dealing with what we found..."
msgstr "Me and my big mouth. Sorry, I’m still dealing with what we found..."

#. Key:	1732780178
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1316).ExplorerNoteEntries.BinkMediaSubtitles(11).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1316).ExplorerNoteEntries.BinkMediaSubtitles(11).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,1732780178"
msgid "We all are. It’s just... I can’t think about any of that right now."
msgstr "We all are. It’s just... I can’t think about any of that right now."

#. Key:	1184873227
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1316).ExplorerNoteEntries.BinkMediaSubtitles(2).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1316).ExplorerNoteEntries.BinkMediaSubtitles(2).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,1184873227"
msgid "The scales of justice must be balanced."
msgstr "The scales of justice must be balanced."

#. Key:	2091434927
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1316).ExplorerNoteEntries.BinkMediaSubtitles(3).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1316).ExplorerNoteEntries.BinkMediaSubtitles(3).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,2091434927"
msgid "I am going after Rockwell."
msgstr "I am going after Rockwell."

#. Key:	2267280166
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1316).ExplorerNoteEntries.BinkMediaSubtitles(4).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1316).ExplorerNoteEntries.BinkMediaSubtitles(4).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,2267280166"
msgid "Yeah, I figured that. Let me come with you!"
msgstr "Yeah, I figured that. Let me come with you!"

#. Key:	2376405411
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1316).ExplorerNoteEntries.BinkMediaSubtitles(5).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1316).ExplorerNoteEntries.BinkMediaSubtitles(5).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,2376405411"
msgid "Only if you promise not to stand in my way. This is more than revenge."
msgstr "Only if you promise not to stand in my way. This is more than revenge."

#. Key:	3204767528
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1316).ExplorerNoteEntries.BinkMediaSubtitles(6).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1316).ExplorerNoteEntries.BinkMediaSubtitles(6).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,3204767528"
msgid "No, I agree. If we let him get away now, who knows how far his sickness will spread?"
msgstr "No, I agree. If we let him get away now, who knows how far his sickness will spread?"

#. Key:	781547610
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1316).ExplorerNoteEntries.BinkMediaSubtitles(7).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1316).ExplorerNoteEntries.BinkMediaSubtitles(7).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,781547610"
msgid "Believe it or not, Diana would be pleased to see us together in this."
msgstr "Believe it or not, Diana would be pleased to see us together in this."

#. Key:	1921702718
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1316).ExplorerNoteEntries.BinkMediaSubtitles(8).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1316).ExplorerNoteEntries.BinkMediaSubtitles(8).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,1921702718"
msgid "She sure had an open mind... and a big heart too. One of a kind."
msgstr "She sure had an open mind... and a big heart too. One of a kind."

#. Key:	3094742742
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1316).ExplorerNoteEntries.BinkMediaSubtitles(9).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1316).ExplorerNoteEntries.BinkMediaSubtitles(9).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,3094742742"
msgid "Unless... Those cloning machines, our implants --"
msgstr "Unless... Those cloning machines, our implants --"

#. Key:	2720971969
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1317).ExplorerNoteEntries.BinkMediaSubtitles(0).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1317).ExplorerNoteEntries.BinkMediaSubtitles(0).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,2720971969"
msgid "<<Meiyin and Helena Walker>> Archival Audio 007\r\n\r\nThe following conversation took shortly after Maiyin and Helena arrive on the Extinct Earth."
msgstr "<<Meiyin and Helena Walker>> Archival Audio 007\r\n\r\nThe following conversation took shortly after Maiyin and Helena arrive on the Extinct Earth."

#. Key:	323732029
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1317).ExplorerNoteEntries.BinkMediaSubtitles(0).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1317).ExplorerNoteEntries.BinkMediaSubtitles(0).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,323732029"
msgid "I need to ask you something,"
msgstr "I need to ask you something,"

#. Key:	2256151596
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1317).ExplorerNoteEntries.BinkMediaSubtitles(1).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1317).ExplorerNoteEntries.BinkMediaSubtitles(1).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,2256151596"
msgid "...but when I do, I’m scared you’ll think I’m losing my mind."
msgstr "...but when I do, I’m scared you’ll think I’m losing my mind."

#. Key:	4258500102
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1317).ExplorerNoteEntries.BinkMediaSubtitles(10).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1317).ExplorerNoteEntries.BinkMediaSubtitles(10).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,4258500102"
msgid "What sorts of things are these voices saying to you?"
msgstr "What sorts of things are these voices saying to you?"

#. Key:	2659838026
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1317).ExplorerNoteEntries.BinkMediaSubtitles(11).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1317).ExplorerNoteEntries.BinkMediaSubtitles(11).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,2659838026"
msgid "Ummm... That I... "
msgstr "Ummm... That I... "

#. Key:	352544172
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1317).ExplorerNoteEntries.BinkMediaSubtitles(12).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1317).ExplorerNoteEntries.BinkMediaSubtitles(12).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,352544172"
msgid "...have to guide someone to finish the work we started, far in the future."
msgstr "...have to guide someone to finish the work we started, far in the future."

#. Key:	3917468200
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1317).ExplorerNoteEntries.BinkMediaSubtitles(13).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1317).ExplorerNoteEntries.BinkMediaSubtitles(13).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,3917468200"
msgid "Okay, now you are sounding just a little crazy."
msgstr "Okay, now you are sounding just a little crazy."

#. Key:	1705949594
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1317).ExplorerNoteEntries.BinkMediaSubtitles(14).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1317).ExplorerNoteEntries.BinkMediaSubtitles(14).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,1705949594"
msgid "I know. And Meiyin... I’m scared."
msgstr "I know. And Meiyin... I’m scared."

#. Key:	3093878123
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1317).ExplorerNoteEntries.BinkMediaSubtitles(15).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1317).ExplorerNoteEntries.BinkMediaSubtitles(15).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,3093878123"
msgid "We will figure this out together. I promise."
msgstr "We will figure this out together. I promise."

#. Key:	3077580438
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1317).ExplorerNoteEntries.BinkMediaSubtitles(2).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1317).ExplorerNoteEntries.BinkMediaSubtitles(2).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,3077580438"
msgid "After everything, you still worry what I might think of you?"
msgstr "After everything, you still worry what I might think of you?"

#. Key:	684267275
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1317).ExplorerNoteEntries.BinkMediaSubtitles(3).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1317).ExplorerNoteEntries.BinkMediaSubtitles(3).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,684267275"
msgid "Come on -- I’m serious!"
msgstr "Come on -- I’m serious!"

#. Key:	988104798
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1317).ExplorerNoteEntries.BinkMediaSubtitles(4).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1317).ExplorerNoteEntries.BinkMediaSubtitles(4).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,988104798"
msgid "Believe it or not, I'm still kinda intimidated by you."
msgstr "Believe it or not, I'm still kinda intimidated by you."

#. Key:	781043849
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1317).ExplorerNoteEntries.BinkMediaSubtitles(5).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1317).ExplorerNoteEntries.BinkMediaSubtitles(5).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,781043849"
msgid "But yeah, this is serious."
msgstr "But yeah, this is serious."

#. Key:	2507311338
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1317).ExplorerNoteEntries.BinkMediaSubtitles(6).BinkMediaSubtitles.BaseText
