msgctxt "GraphLiteral,3448471304"
msgid "But I kept you from being turned by firing an Engram pulse through the ARK Transmission Network."
msgstr "But I kept you from being turned by firing an Engram pulse through the ARK Transmission Network."

#. Key:	679778298
#. SourceLocation:	/Game/LostColony/Characters/Helena/Voice/s_vo_helena_spawnintro.s_vo_helena_spawnintro.Subtitles(2).Subtitles.Text
