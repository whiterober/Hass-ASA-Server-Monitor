msgctxt "GraphLiteral,3517180247"
msgid "Okay, sure -- he’s worried about your emotional state, but so am I."
msgstr "Okay, sure -- he’s worried about your emotional state, but so am I."

#. Key:	844967978
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1318).ExplorerNoteEntries.BinkMediaSubtitles(11).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1318).ExplorerNoteEntries.BinkMediaSubtitles(11).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,844967978"
msgid "I can handle my own emotions."
msgstr "I can handle my own emotions."

#. Key:	1508323564
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1318).ExplorerNoteEntries.BinkMediaSubtitles(12).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1318).ExplorerNoteEntries.BinkMediaSubtitles(12).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,1508323564"
msgid "But should he not know that you are hearing voices?"
msgstr "But should he not know that you are hearing voices?"

#. Key:	1697164355
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1318).ExplorerNoteEntries.BinkMediaSubtitles(13).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1318).ExplorerNoteEntries.BinkMediaSubtitles(13).BinkMediaSubtitles.BaseText
