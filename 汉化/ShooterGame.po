msgctxt "GraphLiteral,3937739048"
msgid "Bob:  Naturally everyone turned to me first, but I nipped that idea in the bud real quick."
msgstr "Bob:  Naturally everyone turned to me first, but I nipped that idea in the bud real quick."

#. Key:	3750656334
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1271).ExplorerNoteEntries.BinkMediaSubtitles(2).BinkMediaSubtitles.BaseText
