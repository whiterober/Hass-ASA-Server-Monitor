msgctxt "GraphLiteral,1533393814"
msgid "So your offer for my help is... a swift death?"
msgstr "So your offer for my help is... a swift death?"

#. Key:	3126713199
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(34).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(34).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,3126713199"
msgid "I fear our negotiations are off to a discouraging start."
msgstr "I fear our negotiations are off to a discouraging start."

#. Key:	2190209410
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(35).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(35).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,2190209410"
msgid "I must attend to my Queen just now."
msgstr "I must attend to my Queen just now."

#. Key:	2863252544
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(36).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(36).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,2863252544"
msgid "You may avail yourself of this"
msgstr "You may avail yourself of this"

#. Key:	985992431
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(37).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(37).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,985992431"
msgid "...food and drink in my absence."
msgstr "...food and drink in my absence."

#. Key:	830202984
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(38).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(38).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,830202984"
msgid "And don’t worry -- I would never be so craven and deceitful as to"
msgstr "And don’t worry -- I would never be so craven and deceitful as to"

#. Key:	1066098259
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(39).BinkMediaSubtitles.BaseText
