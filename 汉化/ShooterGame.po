msgid "And you know I absolutely never sing, Meiyin!"
msgstr "And you know I absolutely never sing, Meiyin!"

#. Key:	3094894742
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1318).ExplorerNoteEntries.BinkMediaSubtitles(20).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1318).ExplorerNoteEntries.BinkMediaSubtitles(20).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,3094894742"
msgid "Where you go, I will follow."
msgstr "Where you go, I will follow."

#. Key:	3960486384
