msgid "What? What is it? What do you hear, Helena?"
msgstr "What? What is it? What do you hear, Helena?"

#. Key:	1120185340
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(40).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(40).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,1120185340"
msgid "Do pass along my profound regret for Her Majesty’s discomfort."
msgstr "Do pass along my profound regret for Her Majesty’s discomfort."

#. Key:	511698766
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(41).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(41).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,511698766"
msgid "There is something so familiar about her mannerisms,"
msgstr "There is something so familiar about her mannerisms,"

#. Key:	1044062071
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(42).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(42).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,1044062071"
msgid "I can almost..."
msgstr "I can almost..."

#. Key:	3652999466
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(43).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(43).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,3652999466"
msgid "Don’t go anywhere, Doctor."
msgstr "Don’t go anywhere, Doctor."

#. Key:	3199535308
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(5).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(5).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,3199535308"
msgid "Victorian England is a long way from this... purgatory."
msgstr "Victorian England is a long way from this... purgatory."

#. Key:	3548013255
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(5).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(5).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,3548013255"
msgid "A song... One we’ve been singing since time began."
msgstr "A song... One we’ve been singing since time began."

#. Key:	3785907883
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(6).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(6).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,3785907883"
msgid "Don’t you leave me alone. Not again."
msgstr "Don’t you leave me alone. Not again."

#. Key:	3937867203
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(6).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(6).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,3937867203"
msgid "You have me at a disadvantage, Lost King. I am woefully ignorant of your history."
msgstr "You have me at a disadvantage, Lost King. I am woefully ignorant of your history."

#. Key:	2256262399
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(7).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(7).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,2256262399"
msgid "There’s still hope for this world, Meiyin... for life to return to it..."
msgstr "There’s still hope for this world, Meiyin... for life to return to it..."

#. Key:	2547277784
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(7).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(7).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,2547277784"
msgid "Thousands of years ago"
msgstr "Thousands of years ago"

#. Key:	2027754512
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(8).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(8).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,2027754512"
msgid "...I was the scientific administrator of this facility,"
msgstr "...I was the scientific administrator of this facility,"

#. Key:	4173483542
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(8).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(8).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,4173483542"
msgid "But for that to happen, I have to guide the one who will finish this."
msgstr "But for that to happen, I have to guide the one who will finish this."

#. Key:	3683245902
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(9).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(9).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,3683245902"
msgid "What about your life? What about ours?"
msgstr "What about your life? What about ours?"

#. Key:	4098151723
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(9).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(9).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,4098151723"
msgid "...and now I am its absolute ruler."
msgstr "...and now I am its absolute ruler."

#. Key:	3938376686
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1322).ExplorerNoteEntries.BinkMediaSubtitles(0).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1322).ExplorerNoteEntries.BinkMediaSubtitles(0).BinkMediaSubtitles.BaseText
