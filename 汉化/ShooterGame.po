msgctxt "GraphLiteral,1317566551"
msgid "Yes, well... I have far grander ambitions than becoming one of your ‘subjects’."
msgstr "Yes, well... I have far grander ambitions than becoming one of your ‘subjects’."

#. Key:	2216925560
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(24).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(24).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,2216925560"
msgid "Oh, you needn’t worry about"
msgstr "Oh, you needn’t worry about"

#. Key:	1583908821
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(25).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(25).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,1583908821"
msgid "...any further gift-giving on our part."
msgstr "...any further gift-giving on our part."

#. Key:	1416200920
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(26).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(26).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,1416200920"
msgid "Doctor Rockwell,"
msgstr "Doctor Rockwell,"

#. Key:	4291158940
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(27).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(27).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,4291158940"
msgid "...you were summoned here to rid my queen of your"
msgstr "...you were summoned here to rid my queen of your"

#. Key:	1311717694
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(28).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(28).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,1311717694"
msgid "...foul corruption."
msgstr "...foul corruption."

#. Key:	1090438939
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(29).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(29).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,1090438939"
msgid "Were I to do as you demand, I suspect my life would instantly be forfeit."
msgstr "Were I to do as you demand, I suspect my life would instantly be forfeit."

#. Key:	1057355855
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(3).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(3).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,1057355855"
msgid "Or is it Doctor Rockwell?"
msgstr "Or is it Doctor Rockwell?"

#. Key:	847333732
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(3).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(3).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,847333732"
msgid "I can hear it so clearly now..."
msgstr "I can hear it so clearly now..."

#. Key:	4069744973
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(30).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(30).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,4069744973"
msgid "You do not strike me as the forgiving type."
msgstr "You do not strike me as the forgiving type."

#. Key:	3832741528
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(31).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(31).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,3832741528"
msgid "Should my queen succumb to your toxin,"
msgstr "Should my queen succumb to your toxin,"

#. Key:	2475148651
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(32).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(32).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,2475148651"
msgid "I promise your end will be anything but instant."
msgstr "I promise your end will be anything but instant."

#. Key:	1533393814
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(33).BinkMediaSubtitles.BaseText
