msgctxt "GraphLiteral,1393440878"
msgid "Don't worry Survivor, you've been infected by Red Element."
msgstr "Don't worry Survivor, you've been infected by Red Element."

#. Key:	3448471304
#. SourceLocation:	/Game/LostColony/Characters/Helena/Voice/s_vo_helena_spawnintro.s_vo_helena_spawnintro.Subtitles(1).Subtitles.Text
