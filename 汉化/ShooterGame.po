msgid "(agonised scream)"
msgstr "(agonised scream)"

#. Key:	2403582298
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(1).Subtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(1).Subtitles.BaseText
msgctxt "GraphLiteral,2403582298"
msgid "If I cannot stop you, there is still someone left... who can..."
msgstr "If I cannot stop you, there is still someone left... who can..."

#. Key:	1003272165
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(10).Subtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(10).Subtitles.BaseText
msgctxt "GraphLiteral,1003272165"
msgid "Impressive for you to have traveled so very far, Li Meiyin..."
msgstr "Impressive for you to have traveled so very far, Li Meiyin..."

#. Key:	1052809851
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(11).Subtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(11).Subtitles.BaseText
msgctxt "GraphLiteral,1052809851"
msgid "...only to fall prostrate before my feet."
msgstr "...only to fall prostrate before my feet."

#. Key:	2590224720
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(12).Subtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(12).Subtitles.BaseText
msgctxt "GraphLiteral,2590224720"
msgid "Reveal yourself, devil, and we shall see who does the falling!"
msgstr "Reveal yourself, devil, and we shall see who does the falling!"

#. Key:	3492298841
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(13).Subtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(13).Subtitles.BaseText
msgctxt "GraphLiteral,3492298841"
msgid "I have seen your memories within the Codex."
msgstr "I have seen your memories within the Codex."

#. Key:	716171460
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(14).Subtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(14).Subtitles.BaseText
msgctxt "GraphLiteral,716171460"
msgid "You are a broken soul."
msgstr "You are a broken soul."

#. Key:	1205268364
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(15).Subtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(15).Subtitles.BaseText
msgctxt "GraphLiteral,1205268364"
msgid "You left behind those dearest to you."
msgstr "You left behind those dearest to you."

#. Key:	2252744147
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(16).Subtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(16).Subtitles.BaseText
msgctxt "GraphLiteral,2252744147"
msgid "One murdered..."
msgstr "One murdered..."

#. Key:	1503806181
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(17).Subtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(17).Subtitles.BaseText
msgctxt "GraphLiteral,1503806181"
msgid "(chuckle) You'll come back for me, right babe?"
msgstr "(chuckle) You'll come back for me, right babe?"

#. Key:	3731725740
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(18).Subtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(18).Subtitles.BaseText
msgctxt "GraphLiteral,3731725740"
msgid "Never let go. I-- I don't think I can face death again alone."
msgstr "Never let go. I-- I don't think I can face death again alone."

#. Key:	1640901447
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(19).Subtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(19).Subtitles.BaseText
msgctxt "GraphLiteral,1640901447"
msgid "(scream)"
msgstr "(scream)"

#. Key:	1081738473
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(2).Subtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(2).Subtitles.BaseText
msgctxt "GraphLiteral,1081738473"
msgid "My Queen! Hear me... The kingdom is yours. "
msgstr "My Queen! Hear me... The kingdom is yours. "

#. Key:	1784324858
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(20).Subtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(20).Subtitles.BaseText
msgctxt "GraphLiteral,1784324858"
msgid "Meiyin!"
msgstr "Meiyin!"

#. Key:	142102320
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(21).Subtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(21).Subtitles.BaseText
msgctxt "GraphLiteral,142102320"
msgid "...and watched another vanish into nothingness."
msgstr "...and watched another vanish into nothingness."

#. Key:	1078761924
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(22).Subtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(22).Subtitles.BaseText
msgctxt "GraphLiteral,1078761924"
msgid "Never forget, Meiyin... we’re all part of the Dream."
msgstr "Never forget, Meiyin... we’re all part of the Dream."

#. Key:	3892532502
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(23).Subtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(23).Subtitles.BaseText
msgctxt "GraphLiteral,3892532502"
msgid "It's nothing more than that. And I'll always love you there."
msgstr "It's nothing more than that. And I'll always love you there."

#. Key:	618534317
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(24).Subtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(24).Subtitles.BaseText
msgctxt "GraphLiteral,618534317"
msgid "And what of your allies? Left dormant within an endless hibernation, awaiting a savior who may never come."
msgstr "And what of your allies? Left dormant within an endless hibernation, awaiting a savior who may never come."

#. Key:	3777771273
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(25).Subtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(25).Subtitles.BaseText
msgctxt "GraphLiteral,3777771273"
msgid "Well, if we all got such a long wait ahead of us, might as well ride it out in these here glass coffins."
msgstr "Well, if we all got such a long wait ahead of us, might as well ride it out in these here glass coffins."

#. Key:	2476091389
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(26).Subtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(26).Subtitles.BaseText
msgctxt "GraphLiteral,2476091389"
msgid "I could use the beauty sleep. Just hope Little Miss Prof’s right about this, uh, prophecy of hers."
msgstr "I could use the beauty sleep. Just hope Little Miss Prof’s right about this, uh, prophecy of hers."

#. Key:	2075184763
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(27).Subtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(27).Subtitles.BaseText
msgctxt "GraphLiteral,2075184763"
msgid "A thousand years, Helena, sheesh..."
msgstr "A thousand years, Helena, sheesh..."

#. Key:	3341070474
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(28).Subtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(28).Subtitles.BaseText
msgctxt "GraphLiteral,3341070474"
msgid "Now, here at the end of the world, it is just you and I, the last of our kind. "
msgstr "Now, here at the end of the world, it is just you and I, the last of our kind. "

#. Key:	1601764382
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(29).Subtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(29).Subtitles.BaseText
msgctxt "GraphLiteral,1601764382"
msgid "Is this not meant to be?"
msgstr "Is this not meant to be?"

#. Key:	1599015360
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(3).Subtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(3).Subtitles.BaseText
msgctxt "GraphLiteral,1599015360"
msgid "Protect the children! Protect the Lost!"
msgstr "Protect the children! Protect the Lost!"

#. Key:	2783622152
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(30).Subtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(30).Subtitles.BaseText
msgctxt "GraphLiteral,2783622152"
msgid "Time has not been kind to you, Lost King."
msgstr "Time has not been kind to you, Lost King."

#. Key:	1940137133
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(31).Subtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(31).Subtitles.BaseText
msgctxt "GraphLiteral,1940137133"
msgid "Such is the price of eternity. But only a pittance for its many spoils."
msgstr "Such is the price of eternity. But only a pittance for its many spoils."

#. Key:	1562304145
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(32).Subtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(32).Subtitles.BaseText
msgctxt "GraphLiteral,1562304145"
msgid "The true price was your soul, and those of your children."
msgstr "The true price was your soul, and those of your children."

#. Key:	1405020542
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(33).Subtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(33).Subtitles.BaseText
msgctxt "GraphLiteral,1405020542"
msgid "You know what I'm here for. Give me the Codex, and I will leave you in eternal peace."
msgstr "You know what I'm here for. Give me the Codex, and I will leave you in eternal peace."

#. Key:	2941527679
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(34).Subtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(34).Subtitles.BaseText
msgctxt "GraphLiteral,2941527679"
msgid "To give you that would force my kind into starvation."
msgstr "To give you that would force my kind into starvation."

#. Key:	2449033957
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(35).Subtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(35).Subtitles.BaseText
msgctxt "GraphLiteral,2449033957"
msgid "Besides, only I know how to deploy the Codex to create life."
msgstr "Besides, only I know how to deploy the Codex to create life."

#. Key:	1874831995
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(36).Subtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(36).Subtitles.BaseText
msgctxt "GraphLiteral,1874831995"
msgid "Here is my offer: join us as my consort, and when the earth is finally cleansed..."
msgstr "Here is my offer: join us as my consort, and when the earth is finally cleansed..."

#. Key:	1481759321
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(37).Subtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(37).Subtitles.BaseText
msgctxt "GraphLiteral,1481759321"
msgid "...then we shall accomplish what you seek, and bring your beloved pair back into the world."
msgstr "...then we shall accomplish what you seek, and bring your beloved pair back into the world."

#. Key:	279857118
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(38).Subtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(38).Subtitles.BaseText
msgctxt "GraphLiteral,279857118"
msgid "I would never become one of your kind."
msgstr "I would never become one of your kind."

#. Key:	202428140
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(39).Subtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(39).Subtitles.BaseText
msgctxt "GraphLiteral,202428140"
msgid "Hand over the Codex now, or I will take it from you!"
msgstr "Hand over the Codex now, or I will take it from you!"

#. Key:	3253855675
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(4).Subtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(4).Subtitles.BaseText
msgctxt "GraphLiteral,3253855675"
msgid "You will not... (chuckle)(cough)"
msgstr "You will not... (chuckle)(cough)"

#. Key:	3134640474
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(40).Subtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(40).Subtitles.BaseText
msgctxt "GraphLiteral,3134640474"
msgid "Hmm... (chuckle)"
msgstr "Hmm... (chuckle)"

#. Key:	2791131339
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(41).Subtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(41).Subtitles.BaseText
msgctxt "GraphLiteral,2791131339"
msgid "Then let us see what terrible furies the great Meiyin is capable of."
msgstr "Then let us see what terrible furies the great Meiyin is capable of."

#. Key:	2212236626
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(42).Subtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(42).Subtitles.BaseText
msgctxt "GraphLiteral,2212236626"
msgid "All that rage... such power..."
msgstr "All that rage... such power..."

#. Key:	308499353
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(43).Subtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(43).Subtitles.BaseText
msgctxt "GraphLiteral,308499353"
msgid "You would make a fine queen for my people, and thereby earn your reward."
msgstr "You would make a fine queen for my people, and thereby earn your reward."

#. Key:	2542829056
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(44).Subtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(44).Subtitles.BaseText
msgctxt "GraphLiteral,2542829056"
msgid "My soul and free will are not for sale."
msgstr "My soul and free will are not for sale."

#. Key:	1870280410
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(45).Subtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.BookendSubtitles(20).BookendSubtitles.Subtitles(45).Subtitles.BaseText
msgctxt "GraphLiteral,1870280410"
msgid "Everything in this world has a price, and the soul of man is but a token in the exchange."
msgstr "Everything in this world has a price, and the soul of man is but a token in the exchange."

#. Key:	2427249401
