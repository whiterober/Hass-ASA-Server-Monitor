msgctxt "GraphLiteral,1066098259"
msgid "...poison a guest in my own castle."
msgstr "...poison a guest in my own castle."

#. Key:	2365693711
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(4).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1321).ExplorerNoteEntries.BinkMediaSubtitles(4).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,2365693711"
msgid "You are a man quite far outside his proper time and place."
msgstr "You are a man quite far outside his proper time and place."

