msgctxt "GraphLiteral,4262190950"
msgid "Meeka:  That’s awful! So what did you do?"
msgstr "Meeka:  That’s awful! So what did you do?"

#. Key:	1674957479
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1270).ExplorerNoteEntries.BinkMediaSubtitles(4).BinkMediaSubtitles.BaseText
