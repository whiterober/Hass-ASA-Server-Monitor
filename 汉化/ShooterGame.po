msgid "Bob:  See, the people around at the end left a lot of salvageable junk behind for us. And like they say: \"One man’s trash...\""
msgstr "Bob:  See, the people around at the end left a lot of salvageable junk behind for us. And like they say: \"One man’s trash...\""

#. Key:	2436963795
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1270).ExplorerNoteEntries.BinkMediaSubtitles(6).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1270).ExplorerNoteEntries.BinkMediaSubtitles(6).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,2436963795"
msgid "Meeka:  ...is another person's trash?"
msgstr "Meeka:  ...is another person's trash?"

#. Key:	1721536604
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1271).ExplorerNoteEntries.BinkMediaSubtitles(0).BinkMediaSubtitles.BaseText
