msgctxt "GraphLiteral,513945393"
msgid "I had imagined far more of your humanity remained"
msgstr "I had imagined far more of your humanity remained"

#. Key:	2321001189
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1323).ExplorerNoteEntries.BinkMediaSubtitles(50).BinkMediaSubtitles.BaseText
