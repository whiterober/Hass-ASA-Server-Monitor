#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1318).ExplorerNoteEntries.BinkMediaSubtitles(17).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1318).ExplorerNoteEntries.BinkMediaSubtitles(17).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,1908277859"
msgid "‘Meeting you halfway.'"
msgstr "‘Meeting you halfway.'"

#. Key:	1490704798
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1318).ExplorerNoteEntries.BinkMediaSubtitles(18).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1318).ExplorerNoteEntries.BinkMediaSubtitles(18).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,1490704798"
msgid "Yeah, exactly!"
msgstr "Yeah, exactly!"

#. Key:	1592247249
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1318).ExplorerNoteEntries.BinkMediaSubtitles(19).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1318).ExplorerNoteEntries.BinkMediaSubtitles(19).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,1592247249"
msgid "So, maybe it’s your turn to follow my lead."
msgstr "So, maybe it’s your turn to follow my lead."

#. Key:	982546661
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1318).ExplorerNoteEntries.BinkMediaSubtitles(2).BinkMediaSubtitles.BaseText
