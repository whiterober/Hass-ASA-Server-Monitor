msgctxt "GraphLiteral,3310800977"
msgid "import os, re\r\n\r\nexts = [\"BMP\", \"EXR\", \"PNG\", \"JPG\", \"TGA\", \"DDS\"]\r\nlookups = {\"BC$\":'BC',\r\n           \"BaseColor$\":'BC',           \r\n           \"D$\":'BC',          \r\n           \"Diffuse$\":'BC',\r\n           \"N$\":'N',\r\n           \"Normal$\":'N',\r\n           \"L$\":'L',\r\n           \"Layered$\":\"L\",\r\n           \"E$\":\"E\",\r\n           \"Emissive$\":\"E\"}\r\n\r\n#filename\r\nfolder = os.path.dirname(file_name)\r\nbasename = os.path.basename(file_name).split('.')[0]\r\nfiles = os.listdir(folder)\r\n\r\ntextures = {}\r\nfor key in lookups.keys():\r\n    if re.findall(f'_{key}', basename):\r\n        basename = re.sub(f'_{key}', '', basename, re.IGNORECASE)\r\n\r\nall_textures = {}\r\nfor item in files:\r\n    #print(item)\r\n    #print(f' - image file: {item.split(\".\")[-1].upper() in exts}')\r\n    if item.split('.')[-1].upper() in exts:\r\n        for k,v in lookups.items():            \r\n            #print(f\" - matches basename: {bool(re.findall(f'{basename}_{k}', item.split('.')[0]))}\")\r\n            if re.findall(f'{basename}_{k}', item.split('.')[0]):\r\n                textures[v] = f'{folder}/{item}'\r\n\r\nbase_color = textures.get('BC', '')\r\nnormal = textures.get('N', '')\r\nlayered = textures.get('L', '')\r\nemissive = textures.get('E', '')\r\n\r\nfor k in list(lookups.keys()) + ['^T_', '^MI_', '^MM_', '^M_']:\r\n    basename = re.sub(k,'', basename, re.IGNORECASE)\r\nmaterial_name = f\"MI_{basename}\"\r\n\r\nprint(f'MaterialName {material_name}')\r\nprint(f'BaseColor {base_color}')\r\nprint(f'Normal {normal}')\r\nprint(f'Layered {layered}')\r\nprint(f'Emissive {emissive}')\r\n\r\n"
msgstr "import os, re\r\n\r\nexts = [\"BMP\", \"EXR\", \"PNG\", \"JPG\", \"TGA\", \"DDS\"]\r\nlookups = {\"BC$\":'BC',\r\n           \"BaseColor$\":'BC',           \r\n           \"D$\":'BC',          \r\n           \"Diffuse$\":'BC',\r\n           \"N$\":'N',\r\n           \"Normal$\":'N',\r\n           \"L$\":'L',\r\n           \"Layered$\":\"L\",\r\n           \"E$\":\"E\",\r\n           \"Emissive$\":\"E\"}\r\n\r\n#filename\r\nfolder = os.path.dirname(file_name)\r\nbasename = os.path.basename(file_name).split('.')[0]\r\nfiles = os.listdir(folder)\r\n\r\ntextures = {}\r\nfor key in lookups.keys():\r\n    if re.findall(f'_{key}', basename):\r\n        basename = re.sub(f'_{key}', '', basename, re.IGNORECASE)\r\n\r\nall_textures = {}\r\nfor item in files:\r\n    #print(item)\r\n    #print(f' - image file: {item.split(\".\")[-1].upper() in exts}')\r\n    if item.split('.')[-1].upper() in exts:\r\n        for k,v in lookups.items():            \r\n            #print(f\" - matches basename: {bool(re.findall(f'{basename}_{k}', item.split('.')[0]))}\")\r\n            if re.findall(f'{basename}_{k}', item.split('.')[0]):\r\n                textures[v] = f'{folder}/{item}'\r\n\r\nbase_color = textures.get('BC', '')\r\nnormal = textures.get('N', '')\r\nlayered = textures.get('L', '')\r\nemissive = textures.get('E', '')\r\n\r\nfor k in list(lookups.keys()) + ['^T_', '^MI_', '^MM_', '^M_']:\r\n    basename = re.sub(k,'', basename, re.IGNORECASE)\r\nmaterial_name = f\"MI_{basename}\"\r\n\r\nprint(f'MaterialName {material_name}')\r\nprint(f'BaseColor {base_color}')\r\nprint(f'Normal {normal}')\r\nprint(f'Layered {layered}')\r\nprint(f'Emissive {emissive}')\r\n\r\n"

