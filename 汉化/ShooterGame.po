msgctxt "GraphLiteral,3803295587"
msgid "Meeka:  Not bad, not bad! But, he sounds a little meaner. Or a lot meaner."
msgstr "Meeka:  Not bad, not bad! But, he sounds a little meaner. Or a lot meaner."

#. Key:	2979229569
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1273).ExplorerNoteEntries.BinkMediaSubtitles(7).BinkMediaSubtitles.BaseText
