msgctxt "GraphLiteral,1301198400"
msgid "Together..."
msgstr "Together..."

#. Key:	2255074901
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1318).ExplorerNoteEntries.BinkMediaSubtitles(15).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1318).ExplorerNoteEntries.BinkMediaSubtitles(15).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,2255074901"
msgid "That’s it -- let me help you."
msgstr "That’s it -- let me help you."

#. Key:	2824826759
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1318).ExplorerNoteEntries.BinkMediaSubtitles(16).BinkMediaSubtitles.BaseText
