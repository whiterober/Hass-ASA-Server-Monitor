msgctxt "GraphLiteral,2559269749"
msgid "Bet you’re handy as they come in a firefight."
msgstr "Bet you’re handy as they come in a firefight."

#. Key:	2755184442
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1312).ExplorerNoteEntries.BinkMediaSubtitles(9).BinkMediaSubtitles.BaseText
