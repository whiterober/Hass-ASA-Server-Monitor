msgctxt "GraphLiteral,3383159274"
msgid "import unreal\r\n\r\nscalar_parameters = mpc.get_editor_property('scalar_parameters')\r\nchanged = False\r\nchanges = []\r\nfor item in scalar_parameters:\r\n    changes.append(item)\r\n    if item.get_editor_property('parameter_name') == name:\r\n        print(name, 'before', item.get_editor_property('default_value'))\r\n        item.set_editor_property('default_value', value)\r\n        print(name, 'after', item.get_editor_property('default_value'))\r\n        changed = True\r\nif changed:\r\n    mpc.set_editor_property('scalar_parameters', changes)\r\n    asset_path = str(mpc.get_path_name()).split('.')[0]\r\n    unreal.EditorAssetLibrary.save_asset(asset_path, only_if_is_dirty=False)\r\n"
msgstr "import unreal\r\n\r\nscalar_parameters = mpc.get_editor_property('scalar_parameters')\r\nchanged = False\r\nchanges = []\r\nfor item in scalar_parameters:\r\n    changes.append(item)\r\n    if item.get_editor_property('parameter_name') == name:\r\n        print(name, 'before', item.get_editor_property('default_value'))\r\n        item.set_editor_property('default_value', value)\r\n        print(name, 'after', item.get_editor_property('default_value'))\r\n        changed = True\r\nif changed:\r\n    mpc.set_editor_property('scalar_parameters', changes)\r\n    asset_path = str(mpc.get_path_name()).split('.')[0]\r\n    unreal.EditorAssetLibrary.save_asset(asset_path, only_if_is_dirty=False)\r\n"

