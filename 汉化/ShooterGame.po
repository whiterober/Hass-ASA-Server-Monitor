#. Key:	2205773388
#. SourceLocation:	/Game/ASA/EditorUtilities/LevelInstanceMerge/EUA_py_scripts.EUA_py_scripts_C:Write Level Instance Description Json [Script Bytecode]
#: /Game/ASA/EditorUtilities/LevelInstanceMerge/EUA_py_scripts.EUA_py_scripts_C:Write Level Instance Description Json [Script Bytecode]
msgctxt "GraphLiteral,2205773388"
msgid "import json, os, datetime;\r\n\r\nfpn_json_out = fpn_json;\r\nlist_instance_transforms = instance_transforms.split('&');\r\n\r\nD = {};\r\n\r\nD['datetime'] = str(datetime.datetime.now());\r\nD['username'] = os.getenv('username');\r\nD['fpn_json'] = fpn_json;\r\nD['level_instance_name'] = linst_name;\r\nD['level_instance_ref'] = linst_path_reference;\r\n\r\nlist_components = []\r\n\r\nfor i in range(len(component_type)):\r\n    C = {};\r\n    C['component_type'] = component_type[i];\r\n    C['sm_path_reference'] = sm_path_reference[i];\r\n    C['sm_path_source'] = sm_path_source[i];\r\n    C['component_transform'] = str(component_transform[i]);\r\n\r\n    list_split_instance_transforms = list_instance_transforms[i].split(',');\r\n    list_clean_instance_transforms = [];\r\n    for j in range(len(list_split_instance_transforms)):\r\n        j_clean = list_split_instance_transforms[j].replace('[','');\r\n        j_clean = j_clean.replace(']','');\r\n        if j_clean != ' ' and j_clean != '':\r\n            #list_split_instance_transforms[j] = j_clean;\r\n            list_clean_instance_transforms.append(j_clean);\r\n    C['instance_transforms'] = list_clean_instance_transforms;\r\n    list_components.append(C);\r\n\r\nD['components'] = list_components;\r\n\r\n#print(D);\r\n#print(\"=================\");\r\n#print(instance_transforms)\r\n\r\nif not os.path.isdir(os.path.dirname(fpn_json)):\r\n    os.makedirs(os.path.dirname(fpn_json));\r\n\r\nwith open(fpn_json, 'w', encoding='utf-8') as f:\r\n    json.dump(D, f, ensure_ascii=False, indent=4)\r\n\r\nprint(len(component_type))"
msgstr "import json, os, datetime;\r\n\r\nfpn_json_out = fpn_json;\r\nlist_instance_transforms = instance_transforms.split('&');\r\n\r\nD = {};\r\n\r\nD['datetime'] = str(datetime.datetime.now());\r\nD['username'] = os.getenv('username');\r\nD['fpn_json'] = fpn_json;\r\nD['level_instance_name'] = linst_name;\r\nD['level_instance_ref'] = linst_path_reference;\r\n\r\nlist_components = []\r\n\r\nfor i in range(len(component_type)):\r\n    C = {};\r\n    C['component_type'] = component_type[i];\r\n    C['sm_path_reference'] = sm_path_reference[i];\r\n    C['sm_path_source'] = sm_path_source[i];\r\n    C['component_transform'] = str(component_transform[i]);\r\n\r\n    list_split_instance_transforms = list_instance_transforms[i].split(',');\r\n    list_clean_instance_transforms = [];\r\n    for j in range(len(list_split_instance_transforms)):\r\n        j_clean = list_split_instance_transforms[j].replace('[','');\r\n        j_clean = j_clean.replace(']','');\r\n        if j_clean != ' ' and j_clean != '':\r\n            #list_split_instance_transforms[j] = j_clean;\r\n            list_clean_instance_transforms.append(j_clean);\r\n    C['instance_transforms'] = list_clean_instance_transforms;\r\n    list_components.append(C);\r\n\r\nD['components'] = list_components;\r\n\r\n#print(D);\r\n#print(\"=================\");\r\n#print(instance_transforms)\r\n\r\nif not os.path.isdir(os.path.dirname(fpn_json)):\r\n    os.makedirs(os.path.dirname(fpn_json));\r\n\r\nwith open(fpn_json, 'w', encoding='utf-8') as f:\r\n    json.dump(D, f, ensure_ascii=False, indent=4)\r\n\r\nprint(len(component_type))"

