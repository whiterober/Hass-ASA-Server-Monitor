#: /Game/ASA/CoreBlueprints/FoliageInteraction/EditorUtility/EU_FoliageProcessingTools/EUW_prepHierarchy_dialog.EUW_prepHierarchy_dialog_C:source_file_is_fbx_rig [Script Bytecode]
msgctxt "GraphLiteral,1745385375"
msgid "import re, os\r\nregex = re.compile('_Rig\\.[a-zA-Z0-9\\.]+$', re.IGNORECASE)\r\nresult = bool(re.findall(regex, str(name)))\r\nrig_path = str(name)\r\nstatic_path = ''\r\n\r\nif result:\r\n    static_path = rig_path\r\n    # print(f'static_path before: {static_path}')\r\n    for x in re.findall(regex, static_path):\r\n        static_path = re.sub(x, '.fbx', static_path)\r\n    # print(f'static_path after: {static_path}')\r\n\r\nelif bool(rig_path):\r\n    static_path = rig_path\r\n    folder = os.path.dirname(rig_path)\r\n    check_rig_path = f'{folder}/{os.path.basename(rig_path).split(\".\")[0]}_Rig.fbx'\r\n    rig_path = ''\r\n    for item in os.listdir(folder):\r\n        test_path = f'{folder}/{str(item)}'\r\n        # print(f'{test_path.lower() == check_rig_path.lower()}')\r\n        # print (f' {test_path}')\r\n        # print (f' {check_rig_path}')\r\n        if test_path.lower() == check_rig_path.lower():\r\n            rig_path = test_path\r\n            result = True\r\n            break\r\n\r\n\r\n# print(f'Is Rig         : {result}')\r\n# print(f' - in file     : {str(name)}')\r\n# print(f' - rig_path    : {rig_path}')\r\n# print(f' - static_path : {static_path}')"
msgstr "import re, os\r\nregex = re.compile('_Rig\\.[a-zA-Z0-9\\.]+$', re.IGNORECASE)\r\nresult = bool(re.findall(regex, str(name)))\r\nrig_path = str(name)\r\nstatic_path = ''\r\n\r\nif result:\r\n    static_path = rig_path\r\n    # print(f'static_path before: {static_path}')\r\n    for x in re.findall(regex, static_path):\r\n        static_path = re.sub(x, '.fbx', static_path)\r\n    # print(f'static_path after: {static_path}')\r\n\r\nelif bool(rig_path):\r\n    static_path = rig_path\r\n    folder = os.path.dirname(rig_path)\r\n    check_rig_path = f'{folder}/{os.path.basename(rig_path).split(\".\")[0]}_Rig.fbx'\r\n    rig_path = ''\r\n    for item in os.listdir(folder):\r\n        test_path = f'{folder}/{str(item)}'\r\n        # print(f'{test_path.lower() == check_rig_path.lower()}')\r\n        # print (f' {test_path}')\r\n        # print (f' {check_rig_path}')\r\n        if test_path.lower() == check_rig_path.lower():\r\n            rig_path = test_path\r\n            result = True\r\n            break\r\n\r\n\r\n# print(f'Is Rig         : {result}')\r\n# print(f' - in file     : {str(name)}')\r\n# print(f' - rig_path    : {rig_path}')\r\n# print(f' - static_path : {static_path}')"

