msgid "Bob:  Santiago wanted another crack at it, and asked if we wanted in."
msgstr "Bob:  Santiago wanted another crack at it, and asked if we wanted in."

#. Key:	3472924234
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1261).ExplorerNoteEntries.BinkMediaSubtitles(6).BinkMediaSubtitles.BaseText
