msgid " <<Meiyin and Diana Altaras>> Archival Audio 003\r\nCross-reference:  <<Santiago Da Costa>>\r\n\r\nThe following conversation took place on the Aberrant ARK, after Meiyin finished a difficult training session with Santiago."
msgstr " <<Meiyin and Diana Altaras>> Archival Audio 003\r\nCross-reference:  <<Santiago Da Costa>>\r\n\r\nThe following conversation took place on the Aberrant ARK, after Meiyin finished a difficult training session with Santiago."

#. Key:	1700059697
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1313).ExplorerNoteEntries.BinkMediaSubtitles(1).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1313).ExplorerNoteEntries.BinkMediaSubtitles(1).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,1700059697"
msgid "You are the better teacher."
msgstr "You are the better teacher."

#. Key:	3584520472
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1313).ExplorerNoteEntries.BinkMediaSubtitles(10).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1313).ExplorerNoteEntries.BinkMediaSubtitles(10).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,3584520472"
msgid "It would be hard to strike out alone again in this poisoned wilderness..."
msgstr "It would be hard to strike out alone again in this poisoned wilderness..."

#. Key:	167223709
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1313).ExplorerNoteEntries.BinkMediaSubtitles(11).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1313).ExplorerNoteEntries.BinkMediaSubtitles(11).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,167223709"
msgid "You do, and we may never get that chance to save each other."
msgstr "You do, and we may never get that chance to save each other."

#. Key:	4241061024
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1313).ExplorerNoteEntries.BinkMediaSubtitles(12).BinkMediaSubtitles.BaseText
#: /Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1313).ExplorerNoteEntries.BinkMediaSubtitles(12).BinkMediaSubtitles.BaseText
msgctxt "GraphLiteral,4241061024"
msgid "Very well. Just... give me time to nurse my wounded pride."
msgstr "Very well. Just... give me time to nurse my wounded pride."

#. Key:	1313850683
#. SourceLocation:	/Game/PrimalEarth/CoreBlueprints/PrimalGameDataARKNX_BP.Default__PrimalGameDataARKNX_BP_C.ExplorerNoteEntries(1313).ExplorerNoteEntries.BinkMediaSubtitles(13).BinkMediaSubtitles.BaseText
