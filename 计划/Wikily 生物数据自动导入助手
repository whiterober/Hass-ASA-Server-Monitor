### 1.2 核心逻辑

```javascript
// 同源 PROPFIND 列文件（无 CORS 问题）
async function listFiles() {
    const res = await fetch('.', {
        method: 'PROPFIND',
        headers: { 'Depth': '1' }
    });
    const xml = await res.text();
    return parseXmlForIniFiles(xml);  // 提取 .ini 文件名
}

// 同源 GET 读文件
async function readFile(filename) {
    const res = await fetch(filename);
    return await res.text();
}

// 解析 .ini
function parseIni(text) {
    const result = { stats: [] };
    for (const line of text.split('\n')) {
        const m = line.match(/^(\w+(?:\[\d+\])?)\s*=\s*(.*)$/);
        if (!m) continue;
        const [, key, val] = m;
        if (key === 'DinoClass') {
            const parts = val.split('.');
            result.blueprint = parts[parts.length - 1].replace(/'/g, '');
        } else if (key === 'DinoNameTag') {
            result.name = val;
        } else if (key === 'BaseLevel') {
            result.level = parseInt(val);
        } else if (key.startsWith('Stats[')) {
            result.stats[parseInt(key.match(/\d+/)[0])] = parseFloat(val);
        } else if (key === 'TamedEffectiveness') {
            result.tameEff = parseFloat(val);
        } else if (key === 'RandomMutationsFemale') {
            result.matMutations = parseInt(val);
        } else if (key === 'RandomMutationsMale') {
            result.patMutations = parseInt(val);
        }
    }
    return result;
}

// 跳转 Wikily
function openWikily(data) {
    const encoded = btoa(unescape(encodeURIComponent(JSON.stringify(data))));
    window.open(
        'https://wikily.gg/zh-cn/ark-survival-ascended/profile/你的用户名/#import=' + encoded,
        '_blank'
    );
}
```

