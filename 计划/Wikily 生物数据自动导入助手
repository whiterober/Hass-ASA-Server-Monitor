## 步骤 2：创建 Tampermonkey 接收脚本

```javascript
// ==UserScript==
// @name         Wikily Dino Importer Receiver
// @namespace    https://hass.whiterober.com/
// @version      1.0
// @match        https://wikily.gg/zh-cn/ark-survival-ascended/profile/*
// @grant        none
// ==/UserScript==

(function() {
    const hash = location.hash;
    if (!hash.startsWith('#import=')) return;

    const encoded = hash.substring(8);
    let data;
    try {
        data = JSON.parse(decodeURIComponent(escape(atob(encoded))));
    } catch(e) {
        console.error('Wikily Importer: decode failed', e);
        return;
    }
    history.replaceState(null, '', location.pathname + location.search);

    // 页面右下角注入按钮
    const btn = document.createElement('button');
    btn.textContent = `🚀 导入 ${data.name || data.blueprint || '生物'}`;
    Object.assign(btn.style, {
        position: 'fixed', bottom: '20px', right: '20px', zIndex: '9999',
        background: '#7c3aed', color: 'white', padding: '12px 20px',
        borderRadius: '8px', border: 'none', cursor: 'pointer',
        fontSize: '14px', boxShadow: '0 4px 12px rgba(124,58,237,0.4)'
    });
    btn.onclick = async () => {
        btn.textContent = '⏳ 导入中...';
        btn.disabled = true;
        try {
            await submitToWikily(data);
            alert('✅ 导入成功！');
            location.reload();
        } catch(e) {
            alert('❌ ' + e.message);
            btn.textContent = '🚀 重试';
            btn.disabled = false;
        }
    };
    document.body.appendChild(btn);

    async function submitToWikily(d) {
        const statNames = ['health','stamina','oxygen','food','weight',
            'melee_damage_multiplier','speed_multiplier'];
        const wild = {};
        d.stats?.forEach((v,i) => { if (i < 7 && v > 0) wild[statNames[i]] = v; });

        const res = await fetch('/api/ark/user-creatures/create/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                species_blueprint: d.blueprint,
                name: d.name || null,
                sex: d.sex || '?',
                wild_levels: wild,
                dom_levels: {},
                mutations: {},
                tags: [],
                notes: 'Imported via NAS Bridge',
                mutations_maternal: d.matMutations || 0,
                mutations_paternal: d.patMutations || 0,
                tame_effectiveness: d.tameEff || null,
                traits: [],
                colors: []
            })
        });
        if (!res.ok) {
            const err = await res.json().catch(() => ({}));
            throw new Error(err.error || 'HTTP ' + res.status);
        }
    }
})();
```

> ⚠️ 替换 `你的用户名` 为实际 Wikily 用户名。

