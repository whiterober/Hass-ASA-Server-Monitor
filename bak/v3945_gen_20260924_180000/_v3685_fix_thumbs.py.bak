def _stem(k):
    return re.sub(r'^PrimalItem[A-Za-z]*_', '', str(k))
def dupby(f):
    d = {}
    for g, k in allk:
        # v3755（回滚 v3754）：已被 alias 归并的键不参与判重（用户确认此逻辑正确）
        # v3880（用户实测「藏宝箱 / 发电机」漏报根因）：**仅跳过「真归并」alias**。
        #   词典 2782 键里 1026 条带 alias，其中大量是**「自指完整类名映射」**
        #   （TreasureCache_ASA → PrimalItemStructure_TreasureCache_ASA、PowerGenerator → PrimalItemStructure_PowerGenerator…），
        #   这类 alias **不表示已归并**（两条不同物品各指向自己的完整类名），必须照常参与判重，
        #   否则「浮窗里看得见的重复、表里全看不见」。判据：alias == 某前缀 + 自身 ⇒ 视为自指（不跳过）。
        _al = (zh.get(k) or {}).get('alias')
        if _al:
            _self = False
            for _p in _PRE:
                if str(_al) == _p + str(k):
                    _self = True
                    break
            if not _self:
                continue
        val = str((zh.get(k) or {}).get(f) or '').strip()
        if not val:
            continue
        if f == 'en':
            val = re.sub(r'^Dye[\s_]+', '', val).lower()
        d.setdefault(val, []).append((g, k))
    out = {}
    for v, L in d.items():
        if len(L) <= 1:
            continue
        if len(set(_stem(k) for _, k in L)) <= 1:
            continue
        out[v] = L
    return out
