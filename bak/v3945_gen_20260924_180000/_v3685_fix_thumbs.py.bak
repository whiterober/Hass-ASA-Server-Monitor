_seen = {}
for _b, _v in zh0.items():
    if not isinstance(_v, dict):
        continue
    _k = str(_v.get('kind') or '')
    if _k not in groups:
        continue
    if re.match(r'^Fertilized\s', str(_v.get('en') or ''), re.I):
        continue
    # v3890（用户要求）：皮肤类（Skin_ / PrimalItemStructureSkin_ 前缀，或 alias 指向皮肤键）不参与对照
    if _k == 'structure' and (_v.get('skin') or re.match(r'^(Skin_|PrimalItemStructureSkin_)', _b)
                              or re.match(r'^PrimalItemStructureSkin_', str(_v.get('alias') or ''))):
        continue
    # v3892b（用户口径「只排本体键，但是要根据重名规则自动排除或不排除」）：
    #   BaseBP 世界本体键（非 PrimalItem 前缀）——**仅当存在同 zh/en 的物品形式对偶键时才排除**
    #   （对偶 = alias 指向的 PrimalItem* 键，或词典内任意同 zh/en 的 PrimalItem* 键；无对偶则保留为独立条目）
    if 'BaseBP' in _b and not _b.startswith('PrimalItem'):
        _al = str(_v.get('alias') or '')
        _av = zh0.get(_al) or {}
        _dup = bool(_al) and bool(_av) \
            and str(_av.get('zh') or '') == str(_v.get('zh') or '') \
            and str(_av.get('en') or '') == str(_v.get('en') or '')
        if not _dup:
            for _k2, _v2 in zh0.items():
                _v2 = _v2 or {}
                if _k2 != _b and str(_k2).startswith('PrimalItem') \
                   and str(_v2.get('zh') or '') == str(_v.get('zh') or '') \
                   and str(_v2.get('en') or '') == str(_v.get('en') or ''):
                    _dup = True
                    break
        if _dup:
            continue
    if _v.get('switch'):
        continue
    if _k == 'structure' and str(_v.get('src') or '') == 'facility_zh':
        _k = 'facility'
    if (u'染料' in str(_v.get('zh') or '') or re.match(r'^Dye_', _b)) and _b != 'Dye' and str(_v.get('en') or '') != 'Dyes':
        _k = 'dye'
    _agg = re.sub(r'^PrimalItem[A-Za-z]*_', '', _b)
