    return cnt.get(k, 0) + cnt.get(b, 0) + cnt.get('PrimalItemStructure_' + b, 0)
# v3721：完整类名（标准补全 + 存档实际）
_PRE = ['PrimalItemConsumable_', 'PrimalItemStructure_', 'PrimalItemAmmo_', 'PrimalItemWeapon_',
        'PrimalItemArmor_', 'PrimalItemResource_', 'PrimalItemTrophy_', 'PrimalItemSkin_',
        'PrimalItem_', 'PrimalItemStructureGeneric_']
# v3894（用户要求「完整类名列必须带前缀」，口径 = 只做可确证项、不推断）：
#   三级确证来源 ① 存档实际类名（cnset）→ ② 词典内同 stem 的带前缀键 → ③ 词典键自身 alias（PrimalItem*）；
#   三级均无法确证 ⇒ 保留原名（不猜前缀）
_PREKEY = None   # v3894c：惰性构建（_stem 定义在本函数之后，模块级立即调用会 NameError）
def cnames(k):
    """返回 (完整类名, 存档实际类名)；v3894 起尽量给出带 PrimalItem 前缀的完整类名（仅可确证来源）"""
    global _PREKEY
    if _PREKEY is None:
        _PREKEY = {}
        for _kk in zh:
            if re.match(r'^PrimalItem', str(_kk)):
                _PREKEY.setdefault(_stem(_kk), _kk)
    ks = _stem(k)
    allc = sorted(c for c in cnset if _stem(c) == ks)
    full = ''
    if allc:
        for p in _PRE:
            if p + ks in allc:
                full = p + ks
                break
        if not full:
            full = k if k in allc else allc[0]
    if not re.match(r'^PrimalItem', str(full or '')):
        full = _PREKEY.get(ks) or full
    if not re.match(r'^PrimalItem', str(full or '')):
        _al = str((zh.get(k) or {}).get('alias') or '')
        if re.match(r'^PrimalItem', _al):
            full = _al
    if not full:
        full = k
    return full, [c for c in allc if c != full]
def resolve(ic):
    if not ic:
        return ''
    if ic.startswith('http'):
        return ic
    if ic in iurl:
        return iurl[ic] or ''
    lk = ic.lower()
    if lk in iurl_l:
        return iurl_l[lk] or ''
    for nm, u in iurl.items():
        if nm and u and lk in nm.lower():
            return u
    return ''
def absu(u):
    if not u:
        return ''
    return u if u.startswith('http') else CF + u.lstrip('/')
def thumb(k):
    ic = str((zh.get(k) or {}).get('icon') or '')
    orig_u = resolve(ic)
    w = wm.get(orig_u, '')
    return absu(w) if w else absu(orig_u), absu(orig_u), ic
# v3905（用户口径「固定印痕在更早期就排除，不走 switch 标记」）：
#   判据与容器组 lbGroupInvHas() 完全一致 —— lbIsBp(it) && lbIsFixedRecipeBp(it)
#   =（isBlueprint==1 || type=='blueprint'）且（rated 为 0/空 || rating==-1）
#   "纯固定印痕" = 该 class 在存档缓存 tmp/_itemcache/*.json 的全部实例都满足该判据（无实物实例）
#   ⇒ 这类键在**分组判重之前**剔除（与 skin/switch/Fertilized 同级过滤）
_FIX = set()
_PX = ['PrimalItemConsumable_', 'PrimalItemStructure_', 'PrimalItemAmmo_', 'PrimalItemWeapon_',
       'PrimalItemArmor_', 'PrimalItemResource_', 'PrimalItemSkin_', 'PrimalItem_']
try:
    _stat = {}
    for _fp in glob.glob(os.path.join(BASE, 'tmp', '_itemcache', '*.json')):
        _d = json.load(io.open(_fp, 'r', encoding='utf-8'))
        for _it in _d.get('items', []):
            _b = str(_it.get('class') or '').split('_C_')[0]
            _e = _stat.setdefault(_b, [0, 0])   # [fix, real]
            _bp = (int(_it.get('isBlueprint') or 0) == 1) or (_it.get('type') == 'blueprint')
            _fx = _bp and (not _it.get('rated') or _it.get('rating') == -1)
            _e[0 if _fx else 1] += 1
    _FIX = set(b for b, (f, r) in _stat.items() if f and not r)
    print('[fixrecipe] 纯固定印痕 class: %d' % len(_FIX))
except Exception as _e:
    print('[fixrecipe] 扫描失败:', _e)

def _is_fix_key(k):
    if not _FIX:
        return False
    cand = set([str(k)])
    _al = (zh.get(k) or {}).get('alias')
    if _al:
        cand.add(str(_al))
    for _p in _PX:
        cand.add(_p + str(k))
    try:
        for _cn in cnames(k):
            cand.add(str(_cn))
    except Exception:
        pass
    return bool(cand & _FIX)

allk = [(g, k) for g, ks in groups.items() for k in ks
        if not (zh.get(k) or {}).get('skin') and not (zh.get(k) or {}).get('switch')
        and not re.match(r'^Fertilized\s', str((zh.get(k) or {}).get('en') or ''), re.I)
        and not _is_fix_key(k)]
FIX_SKIPPED = sorted(k for g, ks in groups.items() for k in ks if _is_fix_key(k))
