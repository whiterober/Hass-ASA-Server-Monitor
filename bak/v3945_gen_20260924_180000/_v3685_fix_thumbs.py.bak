       'ammo': u'弹药', 'consumable': u'消耗品', 'attachment': u'附件', 'trophy': u'战利品', 'dye': u'染料', 'egg': u'蛋'}
GC = {'armor': '#60a5fa', 'weapon': '#f87171', 'structure': '#a78bfa', 'facility': '#38bdf8', 'resource': '#fbbf24',
      'ammo': '#fb923c', 'consumable': '#34d399', 'attachment': '#22d3ee', 'trophy': '#4ade80', 'dye': '#c084fc', 'egg': '#facc15'}
def rows(L):
    o = []
    for g, k in sorted(L, key=lambda x: x[1]):
        v = zh.get(k) or {}
        w, o2, icn = thumb(k)
        if w:
            img = '<img src="%s" data-f="%s" loading="lazy" onerror="if(this.dataset.f&&this.src!==this.dataset.f){this.src=this.dataset.f}else{this.outerHTML=\'<b class=x>✗</b>\'}">' % (html.escape(w), html.escape(o2))
        else:
            img = '<b class="x">无</b>'
        _cf, _crs = cnames(k)
        _cn = html.escape(_cf[:60])
        if k != _cf:
            _cn += '<i>键: %s</i>' % html.escape(k[:60])
        for _o in _crs[:2]:
            _cn += '<i>另存: %s</i>' % html.escape(_o[:60])
        o.append('<tr><td class="g" style="color:%s">%s</td><td class="i">%s</td><td>%s</td><td class="en">%s</td>'
                 '<td class="k">%s</td><td class="cn">%s</td><td class="k ic">%s</td><td class="n">%d</td></tr>' % (
                     GC.get(g, '#999'), LAB.get(g, g), img, html.escape(str(v.get('zh') or '')),
                     html.escape(str(v.get('en') or '')[:32]), html.escape(k), _cn,
                     html.escape(('URL:' + icn.split('/')[-1][:20]) if str(icn).startswith('http') else icn[:24]), stat(k)))
    return '\n'.join(o)
def noiconsect():
    """v3919：新增「无图标物品」表；v3927（用户要求）：套用皮肤判据（skin 字段 / Skin_ 前缀 / 完整类名 / alias），皮肤键不列出。"""
    _nk = []
    for _k0, _v0 in zh.items():
        _v0 = _v0 or {}
        if _v0.get('icon'):
            continue
        _cf0, _ = cnames(_k0)
        if _v0.get('skin') or re.match(r'^(Skin_|PrimalItemSkin_|PrimalItemStructureSkin_|PrimalItemCostume_)', _k0) \
           or re.match(r'^PrimalItem(Structure)?Skin_', str(_cf0 or '')) \
           or re.match(r'^PrimalItem(Structure)?Skin_', str(_v0.get('alias') or '')):
            continue
        _nk.append((_k0, _v0))
    o = ['<details><summary style="cursor:pointer"><h2 style="border-left:4px solid #fbbf24;display:inline-block;margin:0">%s <small>%d 条</small></h2></summary>' % (u'六、无图标物品', len(_nk))]
    o.append('<p class="note">词典中 icon 为空的键（含刚清理图标的键）；排序 = 存档实例数降序；"存" = 10 服存档出现次数。（点击标题展开/收起）</p>')
    o.append('<table><thead><tr><th>组</th><th>中文</th><th>英文</th><th>词典键</th><th>完整类名</th><th>存</th></tr></thead><tbody>')
    for k, v in sorted(_nk, key=lambda x: -stat(x[0])):
        g = v.get('kind') or ''
        _cf, _crs = cnames(k)
        _cn = html.escape(_cf[:60])
        if k != _cf:
            _cn += '<i>键: %s</i>' % html.escape(k[:60])
        for _o2 in _crs[:1]:
            _cn += '<i>另存: %s</i>' % html.escape(_o2[:60])
        o.append('<tr><td class="g" style="color:%s">%s</td><td>%s</td><td class="en">%s</td>'
                 '<td class="k">%s</td><td class="cn">%s</td><td class="n">%d</td></tr>' % (
                     GC.get(g, '#999'), LAB.get(g, g or '-'), html.escape(str(v.get('zh') or '')),
                     html.escape(str(v.get('en') or '')[:32]), html.escape(k), _cn, stat(k)))
    o.append('</tbody></table>')
    o.append('</details>')
    return '\n'.join(o)
