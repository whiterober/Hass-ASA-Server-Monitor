        cw, cw2 = wm.get(cu, ''), wm.get(cnu, '')
        im1 = absu(cw) if cw else absu(cu)
        im2 = absu(cw2) if cw2 else absu(cnu)
        o.append('<tr><td>%s</td><td class="k">%s</td>'
                 '<td class="i"><img src="%s" loading="lazy" onerror="this.outerHTML=\'<b class=x>X</b>\'"><br><span class="k">%s</span></td>'
                 '<td class="i" style="background:#132a1e"><img src="%s" loading="lazy" onerror="this.outerHTML=\'<b class=x>X</b>\'"><br><span class="k" style="color:#6ee7b7">%s</span></td>'
                 '<td class="note">%s</td></tr>' % (
                     tag, html.escape(k), html.escape(im1), html.escape(cur[:34]),
                     html.escape(im2), html.escape(cand[:34]), html.escape(note)))
    o.append('</tbody></table>')
    return '\n'.join(o)
def sect(t, D, c, note=''):
    o = ['<h2 style="border-left:4px solid %s">%s <small>%d 组</small></h2>' % (c, t, len(D))]
    if note:
        o.append('<p class="note">%s</p>' % note)
    for i, (val, L) in enumerate(sorted(D.items(), key=lambda x: -len(x[1])), 1):
        o.append('<h3><b>%s.</b> <code>%s</code> <small>%d 条</small></h3>' % (ORIG.get(val, i), html.escape(str(val)[:54]), len(L)))
        o.append('<table><thead><tr><th>组</th><th>图</th><th>中文</th><th>英文</th><th>词典键</th><th>完整类名</th><th>图标键</th><th>存</th></tr></thead><tbody>')
        o.append(rows(L)); o.append('</tbody></table>')
    return '\n'.join(o)
parts = [
    u'<!DOCTYPE html><html lang="zh-CN"><meta charset="utf-8"><title>浮窗重复项对照表</title>',
    u'<style>',
    u'body{background:#0e0e14;color:#d1d5db;font:12px/1.45 "Microsoft YaHei",-apple-system,sans-serif;margin:0;padding:14px 18px}',
    u'h1{font-size:17px;margin:0 0 4px;color:#f3f4f6}',
    u'h2{font-size:14px;margin:20px 0 6px;padding-left:7px;color:#e5e7eb}',
    u'h3{font-size:12.5px;margin:11px 0 4px;color:#c4b5fd;font-weight:500}h3 code{color:#7dd3fc}',
    u'table{border-collapse:collapse;width:100%;margin:2px 0 8px;font-size:11.5px}',
    u'th,td{border:1px solid #232332;padding:2px 6px;vertical-align:middle;white-space:nowrap}',
    u'thead th{background:#181824;color:#93c5fd;font-weight:600;position:sticky;top:0;z-index:2;font-size:11px}',
    u'tbody tr:nth-child(even){background:#14141c}tbody tr:hover{background:#1e1e2e}',
    u'td.i{width:30px;text-align:center}td.i img{width:22px;height:22px;display:block;margin:0 auto;background:#1c1c28;border-radius:3px}',
    u'td.k{color:#7dd3fc;font-family:Consolas,monospace;font-size:11px}td.ic{color:#94a3b8}',
    u'td.en{color:#9ca3af;max-width:210px;overflow:hidden;text-overflow:ellipsis}',
    u'td.n{text-align:right;color:#fbbf24;font-variant-numeric:tabular-nums}td.g{font-size:11px;text-align:center}',
    u'td.cn{color:#93c5fd;font-family:Consolas,monospace;font-size:9.5px;line-height:1.3;white-space:normal;max-width:215px;word-break:break-all}',
    u'td.cn i{display:block;font-style:normal;color:#64748b;font-size:9px}',
    u'.note{color:#6b7280;font-size:11.5px;margin:1px 0 8px}small{color:#6b7280;font-weight:400}b.x{color:#f87171}',
    u'</style>',
    u'<h1>浮窗重复项对照表</h1>',
    u'<p class="note">数据源：线上浮窗实际清单 %s（%d 条 / %d 组）｜ 判定：图标键相同 / 中文完全相同 / 英文归一后相同 ｜ 存 = 10 服存档出现次数</p>' % (ver, len(allk), len(groups)),
    sect(u'一、图标重复', D_IC, '#38bdf8', u'多条物品共用同一图标（同一物的不同写法属正常；不同物品共用则需改图标）。'),
    sect(u'二、中文重复', D_ZH, '#a78bfa', u'多个物品中文名完全相同 —— 浮窗会看到同名两条。'),
    # v3701（用户确认）：英文重复的组都是同一物品（en 相同）⇒ 前端已按 en 聚合为一条，表中无需再列
sect(u'三、英文重复', {}, '#f472b6', u'英文归一后相同即**同一物品**，前端已聚合为一条，无需人工核对（原有 %d 组已撤下）。'),
    sect(u'四、图标嫌疑：同图标但中英文均不同', SUS, '#f87171', u'最可能是误用图标，请重点核对。'),
    candsect(),
    noiconsect(),
    u'</body></html>']
io.open(OUT, 'w', encoding='utf-8', newline='').write('\n'.join(parts))
res.append(u'【输出】%s（%d B）' % (os.path.basename(OUT), os.path.getsize(OUT)))
io.open(BASE + u'\\tmp\\_v3685_out.txt', 'w', encoding='utf-8').write('\n'.join(res))
