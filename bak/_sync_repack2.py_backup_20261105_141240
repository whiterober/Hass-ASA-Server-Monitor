# 2026-11-05 B1c/B1d：外置 UI / 核心脚本 → terser 压缩后改名为 *.min.js
#   设计（用户口径）：
#     · 源文件（app_ui.js / app_core.js）保持带注释可读，永不上传
#     · 上传的是产物 app_ui.min.js / app_core.min.js（去注释+重排版，**不混淆不压缩**）
#     · 环境变量 DINO_NO_MINIFY=1 → 跳过压缩，直接把源文件按 .min.js 名部署（保留退路）
#     · terser 不可用/失败 → 自动回退为原文部署并告警
#     · 压缩产物 node --check 不过 → 中止部署
_MANIFEST = {}

def _sha(p):
    h = hashlib.sha256()
    with io.open(p, 'rb') as f:
        for chunk in iter(lambda: f.read(1 << 20), b''):
            h.update(chunk)
    return h.hexdigest()

def _build_js(src_name, out_name):
    src = os.path.join(BASE, src_name)
    if not os.path.isfile(src):
        raise SystemExit('ABORT: missing %s' % src_name)
    dst = os.path.join(flat, out_name)
    minified = False
    if os.environ.get('DINO_NO_MINIFY') == '1':
        shutil.copy2(src, dst)
        print('SKIP-MINIFY %s -> %s（DINO_NO_MINIFY=1）' % (src_name, out_name))
    else:
        npx = shutil.which('npx.cmd') or shutil.which('npx')
        if not npx:
            shutil.copy2(src, dst)
            print('WARN: npx 不可用，%s 原文部署' % src_name)
        else:
            r = subprocess.run([npx, '--yes', 'terser@5', src, '--comments', 'false', '-o', dst],
                               capture_output=True, timeout=300)
            ok = (r.returncode == 0) and os.path.isfile(dst) and os.path.getsize(dst) > 1000
            if not ok:
                shutil.copy2(src, dst)
                print('WARN: terser 失败（rc=%d），%s 原文部署：%s' % (
                    r.returncode, src_name, (r.stderr or b'').decode('utf-8', 'replace')[:160]))
            else:
                chk = subprocess.run(['node', '--check', dst], capture_output=True)
                if chk.returncode != 0:
                    raise SystemExit('ABORT: %s 压缩后 node --check 未通过：%s' % (
                        out_name, (chk.stderr or b'').decode('utf-8', 'replace')[:300]))
                minified = True
    s_sz, d_sz = os.path.getsize(src), os.path.getsize(dst)
    print('%s -> %s  %d -> %d B（%.1f%%%s）' % (
        src_name, out_name, s_sz, d_sz, (d_sz - s_sz) * 100.0 / max(1, s_sz),
        '，已压缩' if minified else '，未压缩'))
    _MANIFEST[out_name] = {
        'source': src_name, 'source_sha256': _sha(src),
        'output_sha256': _sha(dst), 'source_bytes': s_sz, 'output_bytes': d_sz,
        'minified': minified,
    }

_build_js('app_ui.js', 'app_ui.min.js')
