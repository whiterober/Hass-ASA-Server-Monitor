# 2026-11-05：外置资源 ?v= 自动对齐当前 LB_VERSION
#   防坑：标签里的版本号若手工遗留在旧值，app_data.js 内容更新后客户端仍读旧缓存
_html_p = os.path.join(flat, 'index.html')
_h = io.open(_html_p, encoding='utf-8').read()
_mv = re.search(r"var LB_VERSION = '(v[0-9]+-[0-9]+)'", _h)
if _mv:
    _ver = _mv.group(1)
    _n = 0
    for _f in ('app.css', 'app_data.js', 'app_ui.min.js', 'app_core.min.js'):
        _h, _c = re.subn(r'(/' + re.escape(_f) + r'\?v=)[^"\']+', r'\g<1>' + _ver, _h)
        _n += _c
    io.open(_html_p, 'w', encoding='utf-8', newline='').write(_h)
    print('asset ?v= -> %s（改写 %d 处）' % (_ver, _n))
    # 构建清单：记录源/产物 sha256，便于追溯“线上这份对应哪个源”
    _MANIFEST['version'] = _ver
    _MANIFEST['built_at'] = __import__('time').strftime('%Y-%m-%d %H:%M:%S')
    io.open(os.path.join(flat, 'build_manifest.json'), 'w', encoding='utf-8', newline='').write(
        json.dumps(_MANIFEST, ensure_ascii=False, indent=2))
    print('build_manifest.json 已生成（%d 项）' % len(_MANIFEST))
else:
    print('WARN: LB_VERSION 未找到，跳过 ?v= 对齐')

