<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>采集流程 · 一体化编辑效果预览（plan-v4）</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@mdi/font@7.4.47/css/materialdesignicons.min.css">
<style>
:root{
  --panel:#16161f; --card:#1a1a24; --chip:#22222c; --btn:#33333d;
  --line:#2a2a3a; --line2:#3a3a4a; --txt:#e6e6f0; --txt2:#cbd5e1; --muted:#8b8b9a;
  --accent:#7c3aed;
}
*{margin:0;padding:0;box-sizing:border-box}
body{background:#0b0b12;color:#e0e0e0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;padding:20px}
.pagehd{max-width:900px;margin:0 auto 16px;display:flex;align-items:baseline;gap:10px;flex-wrap:wrap}
.pagehd h1{font-size:16px;color:#fff;font-weight:600}
.pagehd .sub{font-size:12px;color:var(--muted)}
.wrap{max-width:900px;margin:0 auto;display:grid;grid-template-columns:minmax(0,1fr);gap:14px}
.note{font-size:11px;color:var(--muted);line-height:1.7;background:#11111a;border:1px dashed var(--line2);border-radius:10px;padding:8px 10px}
.lb-hf-card{background:var(--panel);border:1px solid var(--line);border-left:3px solid #a855f7;border-radius:12px;padding:10px 12px}
.lb-hf-card.slim{border-left-color:#38bdf8}
.chead{display:flex;align-items:center;gap:8px}
.cicon{width:34px;height:34px;object-fit:contain;flex-shrink:0}
.ctitle{font-size:15px;color:#eee;font-weight:600;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ba{background:none;border:none;color:#888;font-size:16px;cursor:pointer;flex-shrink:0}
.tag{display:inline-flex;align-items:center;height:24px;padding:0 8px;border-radius:6px;font-size:12px;line-height:1;border:1px solid;flex-shrink:0}
.tag-ok{border-color:#22c55e;color:#bbf7d0;background:#052e16}
.tag-no{border-color:#64748b;color:#cbd5e1;background:#1e293b}
.tag-rad{border-color:#a855f7;color:#e9d5ff;background:#2b0b3f}
.sec{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:10px}
.sec-lbl{display:inline-flex;align-items:center;gap:6px;font-size:12px;color:var(--muted);flex-shrink:0}
.numdot{width:auto;min-width:28px;height:28px;padding:0 6px;border-radius:6px;background:var(--accent);color:#fff;font-size:12px;display:inline-flex;align-items:center;justify-content:center;line-height:28px;flex-shrink:0}
.chip{display:inline-flex;align-items:center;gap:6px;height:28px;padding:0 8px;border-radius:6px;font-size:12px;line-height:1;background:var(--chip);border:1px solid var(--line2);color:var(--txt2);white-space:nowrap;overflow:hidden}
.chip img.ic{width:26px;height:26px;object-fit:contain;display:block;flex-shrink:0}
.chip.act{gap:6px;padding:0 8px;background:#33333d;border-color:#3a3a4a;color:#e5e7eb}
.chip.verb{background:#33333d;border-color:#3a3a4a;color:#ddd}
.chip.keyb{padding:0 6px;height:28px;background:#33333d;border-color:#3a3a4a;box-shadow:inset 0 -2px 0 #26262e}
.keyimg{height:22px;width:auto;display:block}
.chip.plus{border-style:dashed;background:transparent;color:#cbd5e1;cursor:pointer}
.chip.plus:hover{border-color:var(--accent);color:#fff}
.server-tab{height:28px;min-width:28px;padding:0 8px;border-radius:6px;border:1px solid #333;background:#1a1a24;color:#ccc;display:inline-flex;align-items:center;justify-content:center;font-size:14px;cursor:pointer}
.server-tab.active{background:var(--accent);border-color:var(--accent);color:#fff}
.steps{margin-top:10px;border-top:1px solid var(--line);padding-top:8px}
.steprow{display:flex;align-items:center;gap:8px;flex-wrap:wrap;padding:4px 0;border-radius:6px}
.steprow.editing{background:#1d1d29;box-shadow:inset 0 0 0 1px #7c3aed55}
.steprow.dim{opacity:.55}
.stepnum{width:auto;min-width:28px;height:28px;padding:0 6px;border-radius:6px;background:#2a2a3a;color:#cbd5e1;font-size:12px;display:inline-flex;align-items:center;justify-content:center;flex:0 0 auto;cursor:pointer}
.stepnum:hover{background:var(--accent);color:#fff}
.notemark{color:#f59e0b;font-size:12px;width:28px;text-align:center;flex:0 0 auto}
.divider{height:1px;background:var(--line);margin:8px 0}
.inline-input{height:28px;padding:0 8px;background:var(--chip);border:1px solid var(--accent);border-radius:6px;color:#fff;font-size:12px;min-width:230px;outline:none}
.note-input{height:28px;padding:0 8px;background:transparent;border:none;border-bottom:1px dashed var(--line2);border-radius:0;color:#cbd5e1;font-size:12px;min-width:260px;outline:none}
.note-input:focus{border-bottom-color:var(--accent)}
.caret{display:inline-block;width:1px;height:14px;background:#fff;animation:bl 1s steps(1) infinite;vertical-align:-2px}
@keyframes bl{50%{opacity:0}}
.verbpanel{display:flex;gap:8px;flex-wrap:wrap;align-items:center;padding:8px;background:var(--card);border:1px solid var(--line2);border-radius:10px;box-shadow:0 8px 24px #000a;margin:8px 0 2px}
.verbpanel .chip{cursor:pointer}
.verbpanel .chip:hover{border-color:var(--accent);color:#fff}
.verbpanel .sepv{width:1px;height:20px;background:var(--line2);margin:0 2px}
.foot{display:flex;align-items:center;gap:8px;margin-top:10px;border-top:1px solid var(--line);padding-top:8px}
.btn{height:28px;padding:0 12px;border-radius:6px;background:var(--btn);color:#ddd;border:none;font-size:12px;cursor:pointer;display:inline-flex;align-items:center;justify-content:center}
.btn.primary{background:var(--accent);color:#fff}
.btn.ghost{background:transparent;border:1px solid var(--line2);color:#cbd5e1}
.spacer{flex:1}
.muted{color:var(--muted);font-size:11px}
.demo-hint{font-size:11px;color:#93c5fd;margin-top:6px}
.tagbtn{cursor:pointer;gap:3px}
.tagbtn:hover{border-color:#94a3b8;color:#fff}
.tagmenu{display:flex;gap:8px;flex-wrap:wrap;align-items:center;padding:8px;background:var(--card);border:1px solid var(--line2);border-radius:10px;box-shadow:0 8px 24px #000a;margin:8px 0 2px;width:max-content}
.tagmenu .chip{cursor:pointer}
.chip.on{border-color:var(--accent);color:#fff;background:#2e1065}
.aibox{background:#11111a;border:1px dashed #3a3a4a;border-radius:10px;padding:8px 10px;margin-top:8px}
.airow{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.aiinput{flex:1;min-width:240px;min-height:56px;background:#1a1a24;border:1px solid #3a3a4a;border-radius:6px;color:#e6e6f0;font-size:12px;line-height:1.6;padding:8px 10px;resize:vertical}
.aiinput:focus{outline:none;border-color:#7c3aed}
.aihint{font-size:11px;color:#8b8b9a;margin-top:6px;line-height:1.7}
.aicand{margin-top:8px;border-top:1px dashed #2a2a3a;padding-top:8px}
.aiok{color:#86efac}
.chip.custom{background:transparent;border-style:dashed;border-color:#7c3aed99;color:#e9d5ff}
.verbpanel.scrollx{flex-wrap:nowrap;overflow-x:auto;overflow-y:hidden;scrollbar-width:thin;min-width:0}
.verbpanel.scrollx>*{flex-shrink:0}
.verb-input{height:28px;width:92px;padding:0 8px;border-radius:6px;border:1px dashed #7c3aed;background:#11111a;color:#fff;font-size:12px;outline:none}
.verbadd{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:8px 0 2px;padding:8px;background:#11111a;border:1px dashed #2a2a3a;border-radius:10px}
.verbadd .lbl{font-size:12px;color:#cbd5e1}
.chip.warn{background:#ff9800;border-color:#ff9800;color:#1e1f25}
.chip.hint{background:#2196f3;border-color:#2196f3;color:#1e1f25}
.grp{display:flex;align-items:center;gap:8px;margin:10px 0 2px}
.grp-num{min-width:22px;height:22px;padding:0 5px;border-radius:4px;background:rgba(33,150,243,.25);color:#2196f3;font-size:12px;display:inline-flex;align-items:center;justify-content:center;flex:0 0 auto}
.grp-name{height:23px;padding:0 8px;border-radius:6px;background:rgba(33,150,243,.15);color:#2196f3;font-size:12px;display:inline-flex;align-items:center;flex:0 0 auto}
.grp-line{flex:1;height:1px;background:rgba(33,150,243,.35)}
.chip.sel{outline:2px solid #a855f7;outline-offset:1px}
.colbar{display:inline-flex;align-items:center;gap:6px;padding:6px 8px;background:var(--card);border:1px solid var(--line2);border-radius:10px;box-shadow:0 8px 24px #000a;margin:6px 0 2px}
.colbar .dot{width:22px;height:22px;border-radius:6px;cursor:pointer;border:1px solid rgba(255,255,255,.15)}
.colbar .dot.def{background:rgba(255,255,255,.16)}
.colbar .dot.warn{background:#ff9800}
.colbar .dot.hint{background:#2196f3}
.colbar .clbl{font-size:12px;color:#cbd5e1}
.grp-in{height:23px;padding:0 8px;border-radius:6px;border:1px solid #7c3aed;background:rgba(33,150,243,.12);color:#fff;font-size:12px;outline:none;width:104px}
.grp.collapsed .grp-name{opacity:.8}
.sflow{display:flex;flex-wrap:wrap;align-items:center;gap:8px;padding:2px 0}
.ssep{color:#64748b;font-size:12px;flex:0 0 auto}
.steplbl{font-size:11px;color:#6b7280;flex:0 0 auto}
.phonebox{width:390px;max-width:100%;border:1px dashed #3a3a4a;border-radius:10px;padding:8px 10px;margin-top:8px;background:#11111a}
.inv{filter:invert(1)}
</style>
</head>
<body>
<div class="pagehd">
  <h1>采集流程 · 编辑/预览一体化（plan-v4 效果预览）</h1>
  <span class="sub">动作与图标合并成单个徽章 · 图标不带文字 · 键位用 keys 图标 · 备注可输入</span>
</div>
<div class="wrap">
  <div class="note">
    本轮调整：① 动词与宾语合并为一个徽章（如「骑🦖」「采🪨」），图标不再配文字，长按/悬停看名字；② 键位改用 <b>img.whiterober.ccwu.cc/ASA/keys/</b> 的图标（左键、E、F、空格等）；③ 备注行可直接打字（输入框样式，见第一张卡最后一行）；④ 新增「AI 一键生成」演示（见最后一张卡）；⑤ 新增「新增动作」演示（编辑态卡：`＋ 自定义` → 输入框 → 虚线自定义徽章）；⑥ 新增「阶段分组」（1 准备 / 2 办理 / 3 收尾）与语义色（橙=注意必做、蓝=关键动作），对齐线上毒气洞卡；⑦ 新增三类编辑演示：阶段改名/折叠（编辑态卡）、徽章选中 + 颜色工具条、自定义动作长按菜单。
  </div>

  <div class="lb-hf-card">
    <div class="chead">
      <img class="cicon" src="https://dino.whiterober.ccwu.cc/thumbs/webp96/5d18d1d2dee1_w96.webp" alt="">
      <div class="ctitle">石头富集区</div>
      <span class="tag tag-ok">可达</span>
      <button class="ba" title="折叠"><i class="mdi mdi-chevron-up"></i></button>
    </div>

    <div class="sec">
      <span class="sec-lbl">装备</span>
      <span class="chip" title="吉利胸甲"><img class="ic" src="https://dino.whiterober.ccwu.cc/thumbs/webp96/c97280944bde_w96.webp"></span>
      <span class="chip" title="金属镐"><img class="ic" src="https://dino.whiterober.ccwu.cc/thumbs/webp96/88d5a45755d9_w96.webp"></span>
      <span class="chip" title="熟肉"><img class="ic" src="https://dino.whiterober.ccwu.cc/thumbs/webp96/9e7ba10128a1_w96.webp"></span>
      <span class="chip" title="麻醉药"><img class="ic" src="https://dino.whiterober.ccwu.cc/thumbs/webp96/762f46ca80f6_w96.webp"></span>
    </div>

    <div class="sec">
      <span class="sec-lbl">地图</span>
      <span class="server-tab" title="所有地图"><i class="mdi mdi-earth"></i></span>
      <span class="server-tab active" title="孤岛"><i class="mdi mdi-island"></i></span>
      <span class="server-tab" title="焦土"><i class="mdi mdi-volcano"></i></span>
      <span class="server-tab" title="核心岛"><i class="mdi mdi-orbit"></i></span>
      <span class="server-tab" title="畸变"><i class="mdi mdi-radioactive"></i></span>
    </div>

    <div class="sec">
      <span class="sec-lbl">产出物</span>
      <span class="chip" title="金属锭（点击移除）"><img class="ic" src="https://dino.whiterober.ccwu.cc/thumbs/webp96/5d18d1d2dee1_w96.webp"><span class="muted">✕</span></span>
      <span class="chip" title="石头（点击移除）"><img class="ic" src="https://dino.whiterober.ccwu.cc/thumbs/webp96/dc7ba44980fb_w96.webp"><span class="muted">✕</span></span>
      <span class="chip plus" title="添加产出物">＋</span>
    </div>

    <div class="steps">
      <div class="grp"><span class="grp-num">1</span><span class="grp-name">准备</span><span class="grp-line"></span></div>
      <div class="sflow">
        <span class="chip act" title="骑 甲龙">骑<img class="ic inv" src="https://dino.whiterober.ccwu.cc/thumbs/webp96/996a7b1c9dea_w96.webp"></span>
        <span class="chip keyb" title="左键攻击（采集）"><img class="keyimg" src="https://img.whiterober.ccwu.cc/ASA/keys/IconLeftClick.png"></span>
        <span class="chip act" title="采集 石头">采<img class="ic" src="https://dino.whiterober.ccwu.cc/thumbs/webp96/dc7ba44980fb_w96.webp"></span>
      </div>
      <div class="grp"><span class="grp-num">2</span><span class="grp-name">办理</span><span class="grp-line"></span></div>
      <div class="sflow">
        <span class="chip warn" title="注意：先把身上物品转移出去，否则装不下矿石">转移所有物品</span>
        <span class="chip act" title="从 甲龙">从<img class="ic inv" src="https://dino.whiterober.ccwu.cc/thumbs/webp96/996a7b1c9dea_w96.webp"></span>
        <span class="chip act" title="拿取 石头">拿<img class="ic" src="https://dino.whiterober.ccwu.cc/thumbs/webp96/dc7ba44980fb_w96.webp"></span>
        <span class="chip act" title="放入 精炼炉">入<img class="ic" src="https://dino.whiterober.ccwu.cc/thumbs/webp96/fba442a63bae_w96.webp"></span>
        <span class="ssep" title="另起一步">·</span>
        <span class="chip act hint" title="关键动作：使用 精炼炉">用<img class="ic" src="https://dino.whiterober.ccwu.cc/thumbs/webp96/fba442a63bae_w96.webp"></span>
        <span class="chip act" title="烧炼 金属">烧<img class="ic" src="https://dino.whiterober.ccwu.cc/thumbs/webp96/a6c8a5509bde_w96.webp"></span>
        <span class="chip" title="金属锭"><img class="ic" src="https://dino.whiterober.ccwu.cc/thumbs/webp96/5d18d1d2dee1_w96.webp"></span>
        <span class="ssep" title="另起一步">·</span>
        <span class="chip act" title="开启 精炼炉">开<img class="ic" src="https://dino.whiterober.ccwu.cc/thumbs/webp96/fba442a63bae_w96.webp"></span>
        <span class="chip act" title="取出 金属锭">取<img class="ic" src="https://dino.whiterober.ccwu.cc/thumbs/webp96/5d18d1d2dee1_w96.webp"></span>
        <span class="chip keyb" title="E 键"><img class="keyimg" src="https://img.whiterober.ccwu.cc/ASA/keys/PC_btn_E.png"></span>
        <span class="chip act" title="放入 熔炉">入<img class="ic" src="https://dino.whiterober.ccwu.cc/thumbs/webp96/a6c8a5509bde_w96.webp"></span>
      </div>
      <div class="steprow">
        <span class="notemark">*</span>
        <input class="note-input" value="夜间/雨天视野差，记得带照明（备注可直接打字）">
      </div>
      <div class="grp"><span class="grp-num">3</span><span class="grp-name">收尾</span><span class="grp-line"></span></div>
      <div class="sflow dim">
        <span class="tag tag-no tagbtn" title="点击切换标签">不可达 <i class="mdi mdi-chevron-down"></i></span>
        <span class="chip act" title="传送到 水晶点">传<img class="ic" src="https://dino.whiterober.ccwu.cc/thumbs/webp96/568d78ce318c_w96.webp"></span>
        <span class="chip act" title="采集 水晶">采<img class="ic" src="https://dino.whiterober.ccwu.cc/thumbs/webp96/568d78ce318c_w96.webp"></span>
      </div>
    </div>
    <div class="demo-hint">颜色语义（对齐线上毒气洞卡）：灰＝普通动作 ｜ <b style="color:#ff9800">橙＝注意 / 必做</b>（如「转移所有物品」「查」「戴」）｜ <b style="color:#2196f3">蓝＝关键动作 / 提示</b>（如「用」「转」）。阶段标题＝小序号方块 + 组名蓝胶囊 + 右侧细线，可折叠整段。<b>同阶段内的步骤不强制分行</b>：一行放不下就自动换行，`·` 只表示"另起一步"，不需要手动换行/插分隔。</div>

    <div class="phonebox">
      <div class="muted" style="margin-bottom:6px">手机宽度 390px 实测：<b>同阶段自动换行</b>（不需要手动分行，也没有第 2 行「步骤」概念）</div>
      <div class="sflow">
        <span class="chip warn" title="注意：先转移物品">转移所有物品</span>
        <span class="chip act" title="从 甲龙">从<img class="ic inv" src="https://dino.whiterober.ccwu.cc/thumbs/webp96/996a7b1c9dea_w96.webp"></span>
        <span class="chip act" title="拿取 石头">拿<img class="ic" src="https://dino.whiterober.ccwu.cc/thumbs/webp96/dc7ba44980fb_w96.webp"></span>
        <span class="chip act" title="放入 精炼炉">入<img class="ic" src="https://dino.whiterober.ccwu.cc/thumbs/webp96/fba442a63bae_w96.webp"></span>
        <span class="ssep" title="另起一步">·</span>
        <span class="chip act hint" title="关键动作：用 精炼炉">用<img class="ic" src="https://dino.whiterober.ccwu.cc/thumbs/webp96/fba442a63bae_w96.webp"></span>
        <span class="chip act" title="烧炼 金属">烧<img class="ic" src="https://dino.whiterober.ccwu.cc/thumbs/webp96/a6c8a5509bde_w96.webp"></span>
        <span class="chip" title="金属锭"><img class="ic" src="https://dino.whiterober.ccwu.cc/thumbs/webp96/5d18d1d2dee1_w96.webp"></span>
        <span class="ssep" title="另起一步">·</span>
        <span class="chip act" title="开启 精炼炉">开<img class="ic" src="https://dino.whiterober.ccwu.cc/thumbs/webp96/fba442a63bae_w96.webp"></span>
        <span class="chip act" title="取出 金属锭">取<img class="ic" src="https://dino.whiterober.ccwu.cc/thumbs/webp96/5d18d1d2dee1_w96.webp"></span>
      </div>
    </div>
    <div class="foot">
      <button class="btn ghost" title="撤销上一步">撤销</button>
      <span class="muted">● 未保存</span>
      <span class="spacer"></span>
      <button class="btn">＋ 步骤</button>
      <button class="btn primary">保存</button>
      <button class="btn ghost">取消</button>
    </div>
  </div>

  <div class="lb-hf-card slim">
    <div class="chead">
      <img class="cicon inv" src="https://dino.whiterober.ccwu.cc/thumbs/webp96/996a7b1c9dea_w96.webp" alt="">
      <div class="ctitle">血池（状态分支示例）</div>
      <span class="tag tag-rad">辐射</span>
      <button class="ba" title="折叠"><i class="mdi mdi-chevron-down"></i></button>
    </div>
    <div class="sec">
      <span class="sec-lbl">不可达</span>
      <span class="chip act" title="丢下 甲龙">丢<img class="ic inv" src="https://dino.whiterober.ccwu.cc/thumbs/webp96/996a7b1c9dea_w96.webp"></span>
      <span class="chip verb">还</span>
      <span class="chip act" title="传送">传<img class="ic" src="https://dino.whiterober.ccwu.cc/thumbs/webp96/568d78ce318c_w96.webp"></span>
    </div>
    <div class="sec">
      <span class="sec-lbl">可到达</span>
